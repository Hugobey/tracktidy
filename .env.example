# Public site origin, with https and no path. Used for canonical URLs.
# Confirm this is the live host before launch. The default in code is https://www.track-tidy.com.
VITE_SITE_URL=https://www.track-tidy.com

# Google Analytics 4 measurement ID. Leave this empty to use the stream already
# installed in the Tag Manager container, G-1DQDF61KJW. Set another G- ID to override it.
# Hits are sent only after a visitor accepts analytics.
VITE_GA_MEASUREMENT_ID=

# PostHog project key. Leave this empty to keep PostHog off. A key starts with phc_.
# Set it in the host build environment and rebuild. Do not commit a real key.
# Events are sent only after a visitor accepts analytics.
VITE_POSTHOG_KEY=
# PostHog ingest host. Leave this empty to use https://eu.i.posthog.com.
VITE_POSTHOG_HOST=

# Stripe Payment Link. https only. Leave this empty to keep checkout disconnected.
# The app adds prefilled_email. Set it in the host build settings and rebuild.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Server only. Used by /api/check-pro. Never prefix this with VITE_.
STRIPE_SECRET_KEY=
