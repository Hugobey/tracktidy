# Public site origin, with https and no path. Used for canonical URLs.
# Confirm this is the live host before launch. The default in code is https://www.track-tidy.com.
VITE_SITE_URL=https://www.track-tidy.com

# Google Analytics 4 measurement ID. Leave this empty to use the stream already
# installed in the Tag Manager container, G-1DQDF61KJW. Set another G- ID to override it.
# Hits are sent only after a visitor accepts analytics.
VITE_GA_MEASUREMENT_ID=
