# Public site origin, with https and no path. Used for canonical URLs.
# Confirm this is the live host before launch. The default in code is https://track-tidy.com.
VITE_SITE_URL=https://track-tidy.com

# Google Analytics 4 measurement ID, for example G-XXXXXXXX.
# Leave this empty until the property exists. The script does not load without it,
# and it never loads before a visitor accepts analytics.
VITE_GA_MEASUREMENT_ID=
